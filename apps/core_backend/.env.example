# Core API runtime
DEBUG=false
API_VERSION=/v1
TEMPLATES_DIR=./templates

# Routing engine (required). Valhalla is the only engine since 2026-09;
# engine=otp|otp_kl|hybrid answers HTTP 400 "engine retired: use valhalla".
VALHALLA_URL=http://service-valhalla:8002
# Retired OpenTripPlanner URLs: optional, accepted and ignored if still set.
# OPEN_TRIP_PLANNER_URL=
# OPEN_TRIP_PLANNER_KL_URL=

# Valhalla pedestrian tuning (optional, defaults shown)
# Seconds charged when a walking route enters an access=destination edge.
VALHALLA_PEDESTRIAN_DESTINATION_ONLY_PENALTY=0
# Soft cobblestone avoidance (fork option avoid_bad_surfaces, 0..1) sent for
# walk.surface_quality >= 0.7 (SMOOTH) and 0.3 < surface_quality < 0.7 (MEDIUM).
VALHALLA_AVOID_BAD_SURFACES_SMOOTH=1.0
VALHALLA_AVOID_BAD_SURFACES_MEDIUM=0.4

# Geocoding (required)
# Allowed values: none | pelias
GEOCODING_PROVIDER=none
# Required when GEOCODING_PROVIDER != none
GEOCODING_PROVIDER_API_URL=
# Optional depending on provider
GEOCODING_PROVIDER_API_KEY=

# Redis (optional overrides)
REDIS_HOST=core-redis
REDIS_PORT=6379

# User engagement payload file (optional)
USER_ENGAGEMENT_EVENT_FILE=./events/event.json
